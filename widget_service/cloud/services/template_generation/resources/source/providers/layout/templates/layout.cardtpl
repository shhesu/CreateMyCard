  "width": "matchParent",
  "height": "matchParent",
  "itemMargin": 8,
  "justifyContent": "start",
  "alignItems": "center",
},
  Column({
    "width": "matchParent",
    "layoutWeight": 1
  }, children[0]),
  Column({
    "width": "matchParent",
    "height": 36
  }, children[1])
)
#End

