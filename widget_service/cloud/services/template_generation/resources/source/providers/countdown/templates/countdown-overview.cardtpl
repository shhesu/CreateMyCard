    days: $path("/countdownDays")
}

Row(
  {
    "_advancedComponent": "CountdownOverview",
    "width": "matchParent",
    "height": "matchParent",
    "itemMargin": 16,
    "justifyContent": "spaceBetween",
    "alignItems": "center",
    "clip": true,
    "constraintSize": {"minWidth": 0, "minHeight": 0}
  },
  Column(
