        props.title,
        {"width": "matchParent", "fontSize": 16, "minFontSize": 12, "fontWeight": 600, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}
      )
    ),
    IfAbsent(
      props.title,
