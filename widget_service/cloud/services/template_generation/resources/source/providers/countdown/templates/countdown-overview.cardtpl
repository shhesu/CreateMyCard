      "width": "matchParent",
      "height": "matchParent",
      "layoutWeight": 1,
      "itemMargin": 6,
      "justifyContent": "center",
      "alignItems": "start",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    IfPresent(
      props.title,
