        {"width": "matchParent", "fontSize": 16, "fontWeight": 600, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}
      )
    ),
    Text(
      "距离目标日",
      {"fontSize": 12, "fontWeight": 400, "fontColor": $theme('supportContentColor'), "maxLines": 1}
    )
  ),
  Row(
    {
      "width": "matchParent",
      "height": "matchParent",
      "layoutWeight": 1,
      "itemMargin": 4,
      "justifyContent": "end",
      "alignItems": "center",
      "constraintSize": {"minWidth": 0, "minHeight": 0}
    },
    Text(
      data.days,
      {"fontSize": 52, "fontWeight": 800, "fontColor": $theme('primaryColor'), "maxLines": 1, "textOverflow": "ellipsis"}
    ),
    Text(
      "天",
      {"fontSize": 18, "fontWeight": 500, "fontColor": $theme('supportContentColor'), "maxLines": 1}
